# Copy to .env and fill in. See README.md for how to obtain each value.
# Never commit .env.

# --- App ---
APP_URL=http://localhost:3000
# Generate both secrets below with: npm run secrets
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Access control (the only Google account allowed to sign in) ---
ALLOWED_EMAIL=you@gmail.com

# --- Google OAuth client (one client serves sign-in and the Gmail connection) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase Postgres ---
# Pooled connection (Supavisor, transaction mode, port 6543) for the running app
DATABASE_URL=
# Direct connection (port 5432) used for migrations
DIRECT_DATABASE_URL=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_SUPERVISOR=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini

# --- Optional sync tuning ---
# SYNC_LIST_PAGE_SIZE=100
# GMAIL_CONCURRENCY=5
# AGENT_BATCH_SIZE=5
# AGENT_BATCHES_PER_STEP=2
# SYNC_STALE_LOCK_MINUTES=15
# MAX_MESSAGE_ATTEMPTS=3
